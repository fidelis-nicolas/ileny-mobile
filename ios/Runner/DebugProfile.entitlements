<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug and Profile builds: the APNs sandbox, which is where a device
	     running a development-signed build receives pushes. A build signed with
	     this entitlement cannot be sent to via the production APNs host and
	     vice versa — a token from one environment is silently invalid in the
	     other, which is the usual reason a push "works in TestFlight but not
	     from Xcode" or the reverse. -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- Keychain Sharing. flutter_secure_storage's darwin implementation
	     requires this entitlement to be present even when no access group is
	     named; without it writes appear to succeed and silently store nothing,
	     which here would mean a session that never survives an app restart.
	     Leave the array empty unless the app joins an App Group. -->
	<key>keychain-access-groups</key>
	<array/>
</dict>
</plist>
