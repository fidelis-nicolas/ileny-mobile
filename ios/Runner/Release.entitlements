<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release builds — TestFlight and the App Store — talk to the production
	     APNs host. See the note in DebugProfile.entitlements: the two
	     environments issue separate device tokens and neither accepts the
	     other's. -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- Keychain Sharing. flutter_secure_storage's darwin implementation
	     requires this entitlement to be present even when no access group is
	     named; without it writes appear to succeed and silently store nothing,
	     which here would mean a session that never survives an app restart.
	     Leave the array empty unless the app joins an App Group. -->
	<key>keychain-access-groups</key>
	<array/>
</dict>
</plist>
