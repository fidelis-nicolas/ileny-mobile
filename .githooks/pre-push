#!/usr/bin/env sh
# Server-side protection remains necessary: local hooks can be bypassed.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "Direct updates to $remote_ref are blocked. Push a feature branch and open a pull request." >&2
      exit 1
      ;;
  esac
done
